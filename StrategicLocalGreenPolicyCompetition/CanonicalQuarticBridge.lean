/-- Canonical reduced firm-stage coefficient `L` at the manuscript witness vector. -/
def canonicalL (θ : ℝ) : ℝ :=
  reducedL 4 18 (9 / 10 : ℝ) θ

/-- Polynomial numerator of the canonical reduced two-firm determinant. -/
def canonicalReducedDetNumerator (θ : ℝ) : ℝ :=
  (341 - 100 * θ ^ 2) ^ 2 - 2500 * θ ^ 2 * cournotD θ ^ 2

/-- The common squared denominator factor appearing in the canonical Hessian. -/
def canonicalSlopeCore (θ : ℝ) : ℝ :=
  canonicalReducedDetNumerator θ ^ 2

/-- Canonical Stage-1 Hessian entry inherited from the Phase-6 government bridge. -/
def canonicalGovernmentHessianEntry (θ : ℝ) (i j : PolicyCoord) : ℝ :=
  modelGovernmentHessianEntry 4 18 (9 / 10 : ℝ) (6 / 5 : ℝ)
    (4 / 5 : ℝ) 2 (11 / 10 : ℝ) (17 / 10 : ℝ) (1 / 10 : ℝ)
    (canonicalL θ) θ i j

/-- Canonical numerator of the infrastructure response to the rival subsidy. -/
def canonicalCrossInstrumentNumerator (θ : ℝ) : ℝ :=
  crossInstrumentNumerator
    (canonicalGovernmentHessianEntry θ .sA .hA)
    (canonicalGovernmentHessianEntry θ .sA .sA)
    (canonicalGovernmentHessianEntry θ .sA .sB)
    (canonicalGovernmentHessianEntry θ .hA .sB)

/-- Canonical determinant of jurisdiction A's own-policy Hessian block. -/
def canonicalOwnPolicyDet (θ : ℝ) : ℝ :=
  ownPolicyDet
    (canonicalGovernmentHessianEntry θ .sA .sA)
    (canonicalGovernmentHessianEntry θ .sA .hA)
    (canonicalGovernmentHessianEntry θ .hA .hA)

/-- Positive denominator polynomial in `u = θ²` generated by the own-policy
Hessian determinant at the canonical witness vector. -/
def witnessDetQ (u : ℝ) : ℝ :=
  2423000000 * u ^ 6 - 48022162500 * u ^ 5 +
    380092203500 * u ^ 4 - 1513626514600 * u ^ 3 +
    3201289907783 * u ^ 2 - 3575406211544 * u +
    1926730587848

/-- Integer-scaled Bernstein representation of the determinant polynomial. -/
def witnessDetQBernsteinScaled (u : ℝ) : ℝ :=
  28900958817720 * (1 - u) ^ 6 +
    119774659733160 * u * (1 - u) ^ 5 +
    213378265016745 * u ^ 2 * (1 - u) ^ 4 +
    211081241370780 * u ^ 3 * (1 - u) ^ 3 +
    122907732130170 * u ^ 4 * (1 - u) ^ 2 +
    39896922018000 * u ^ 5 * (1 - u) +
    5602212157305 * u ^ 6

lemma witnessDetQ_scaled_eq_bernstein (u : ℝ) :
    15 * witnessDetQ u = witnessDetQBernsteinScaled u := by
  unfold witnessDetQ witnessDetQBernsteinScaled
  ring

/-- The Hessian-determinant polynomial is strictly positive on the entire rivalry
square range `u ∈ [0,1]`. -/
theorem witnessDetQ_pos {u : ℝ} (hu : u ∈ Icc (0 : ℝ) 1) :
    0 < witnessDetQ u := by
  rcases hu with ⟨hu0, hu1⟩
  by_cases h1 : u = 1
  · subst u
    norm_num [witnessDetQ]
  · have huLt : u < 1 := lt_of_le_of_ne hu1 h1
    have h1u : 0 < 1 - u := by linarith
    have h0 : 0 < 28900958817720 * (1 - u) ^ 6 := by positivity
    have hA : 0 ≤ 119774659733160 * u * (1 - u) ^ 5 := by positivity
    have hB : 0 ≤ 213378265016745 * u ^ 2 * (1 - u) ^ 4 := by positivity
    have hC : 0 ≤ 211081241370780 * u ^ 3 * (1 - u) ^ 3 := by positivity
    have hD : 0 ≤ 122907732130170 * u ^ 4 * (1 - u) ^ 2 := by positivity
    have hE : 0 ≤ 39896922018000 * u ^ 5 * (1 - u) := by positivity
    have hF : 0 ≤ 5602212157305 * u ^ 6 := by positivity
    have hscaled : 0 < 15 * witnessDetQ u := by
      rw [witnessDetQ_scaled_eq_bernstein]
      unfold witnessDetQBernsteinScaled
      nlinarith
    nlinarith

lemma canonicalDetFactor_left_pos {θ : ℝ} (hθ : θ ∈ Icc (0 : ℝ) 1) :
    0 < 50 * θ ^ 3 - 100 * θ ^ 2 - 200 * θ + 341 := by
  have hsq : θ ^ 2 ≤ 1 := by
    nlinarith [mul_nonneg hθ.1 (sub_nonneg.mpr hθ.2)]
  have hcub : 0 ≤ θ ^ 3 := pow_nonneg hθ.1 3
  nlinarith

lemma canonicalDetFactor_right_neg {θ : ℝ} (hθ : θ ∈ Icc (0 : ℝ) 1) :
    50 * θ ^ 3 + 100 * θ ^ 2 - 200 * θ - 341 < 0 := by
  have hsq : θ ^ 2 ≤ 1 := by
    nlinarith [mul_nonneg hθ.1 (sub_nonneg.mpr hθ.2)]
  have hcub_le : θ ^ 3 ≤ 1 := by
    have hnonneg : 0 ≤ θ ^ 2 * (1 - θ) :=
      mul_nonneg (sq_nonneg θ) (sub_nonneg.mpr hθ.2)
    nlinarith
  nlinarith [hθ.1]

lemma canonicalReducedDetNumerator_factor (θ : ℝ) :
    canonicalReducedDetNumerator θ =
      -(50 * θ ^ 3 - 100 * θ ^ 2 - 200 * θ + 341) *
        (50 * θ ^ 3 + 100 * θ ^ 2 - 200 * θ - 341) := by
  unfold canonicalReducedDetNumerator cournotD
  ring

lemma canonicalReducedDetNumerator_pos {θ : ℝ} (hθ : θ ∈ Icc (0 : ℝ) 1) :
    0 < canonicalReducedDetNumerator θ := by
  rw [canonicalReducedDetNumerator_factor]
  exact mul_pos_of_neg_of_neg
    (neg_neg_of_pos (canonicalDetFactor_left_pos hθ))
    (canonicalDetFactor_right_neg hθ)

lemma canonicalSlopeCore_pos {θ : ℝ} (hθ : θ ∈ Icc (0 : ℝ) 1) :
    0 < canonicalSlopeCore θ := by
  unfold canonicalSlopeCore
  exact sq_pos_of_pos (canonicalReducedDetNumerator_pos hθ)

lemma canonicalL_closed {θ : ℝ} (hθ : θ ∈ Icc (0 : ℝ) 1) :
    canonicalL θ = (341 - 100 * θ ^ 2) / (50 * cournotD θ) := by
  have hD : cournotD θ ≠ 0 := (cournotD_pos hθ).ne'
  unfold canonicalL reducedL investmentLambda investmentR
  field_simp [hD]
  unfold cournotD
  ring

lemma canonicalT0_closed {θ : ℝ} (hθ : θ ∈ Icc (0 : ℝ) 1) :
    reducedT0 (canonicalL θ) θ =
      50 * cournotD θ * (341 - 100 * θ ^ 2) /
        canonicalReducedDetNumerator θ := by
  have hD : cournotD θ ≠ 0 := (cournotD_pos hθ).ne'
  have hA : canonicalReducedDetNumerator θ ≠ 0 :=
    (canonicalReducedDetNumerator_pos hθ).ne'
  rw [canonicalL_closed hθ]
  unfold reducedT0 canonicalReducedDetNumerator
  field_simp [hD, hA]
  ring

lemma canonicalT1_closed {θ : ℝ} (hθ : θ ∈ Icc (0 : ℝ) 1) :
    reducedT1 (canonicalL θ) θ =
      -2500 * θ * cournotD θ ^ 2 / canonicalReducedDetNumerator θ := by
  have hD : cournotD θ ≠ 0 := (cournotD_pos hθ).ne'
  have hA : canonicalReducedDetNumerator θ ≠ 0 :=
    (canonicalReducedDetNumerator_pos hθ).ne'
  rw [canonicalL_closed hθ]
  unfold reducedT1 canonicalReducedDetNumerator
  field_simp [hD, hA]
  ring

lemma canonicalChiX_closed (θ : ℝ) :
    interiorChiX 4 θ = 1 / cournotD θ := by
  unfold interiorChiX
  ring

lemma canonicalChiG_closed (θ : ℝ) :
    interiorChiG 18 (9 / 10 : ℝ) θ = 1 / (5 * cournotD θ) := by
  unfold interiorChiG
  ring

lemma canonicalRho_closed (θ : ℝ) :
    producerRho 4 18 (9 / 10 : ℝ) θ =
      1 - 59 / (25 * cournotD θ ^ 2) := by
  unfold producerRho
  rw [canonicalChiX_closed, canonicalChiG_closed]
  ring

/-- Polynomial numerators for the five Hessian entries needed by the response. -/
def canonicalHssPoly (θ : ℝ) : ℝ :=
  74312500 * θ ^ 12 - 1737628125 * θ ^ 10 + 16311746125 * θ ^ 8 -
    78435270800 * θ ^ 6 + 203312608309 * θ ^ 4 -
    269043732787 * θ ^ 2 + 142288292179

def canonicalHshPoly (θ : ℝ) : ℝ :=
  4250000 * θ ^ 12 + 35400000 * θ ^ 10 - 1462181500 * θ ^ 8 +
    11950610900 * θ ^ 6 - 42728067652 * θ ^ 4 +
    70790521867 * θ ^ 2 - 43708399966

def canonicalHhhPoly (θ : ℝ) : ℝ :=
  51250000 * θ ^ 12 - 1029000000 * θ ^ 10 + 8472940000 * θ ^ 8 -
    36039869000 * θ ^ 6 + 84013880320 * θ ^ 4 -
    106205019880 * θ ^ 2 + 62556038413

def canonicalHsCrossPoly (θ : ℝ) : ℝ :=
  1047500 * θ ^ 8 - 14932000 * θ ^ 6 + 75261010 * θ ^ 4 -
    157644181 * θ ^ 2 + 113547544

def canonicalHhCrossPoly (θ : ℝ) : ℝ :=
  102500 * θ ^ 8 - 1205500 * θ ^ 6 + 5196340 * θ ^ 4 -
    8170549 * θ ^ 2 + 1317283

lemma canonicalHss_closed {θ : ℝ} (hθ : θ ∈ Icc (0 : ℝ) 1) :
    canonicalGovernmentHessianEntry θ .sA .sA =
      -canonicalHssPoly θ / (162 * canonicalSlopeCore θ) := by
  simp [canonicalGovernmentHessianEntry, modelGovernmentHessianEntry,
    qASlope, qBSlope, ownSubsidySlope, ownInfrastructureSlope]
  rw [canonicalT0_closed hθ, canonicalT1_closed hθ,
    canonicalChiG_closed, canonicalRho_closed]
  unfold governmentHessianEntry reducedEmissionsSlope canonicalSlopeCore
  field_simp [(cournotD_pos hθ).ne', (canonicalReducedDetNumerator_pos hθ).ne']
  unfold canonicalHssPoly canonicalReducedDetNumerator cournotD
  ring

lemma canonicalHsh_closed {θ : ℝ} (hθ : θ ∈ Icc (0 : ℝ) 1) :
    canonicalGovernmentHessianEntry θ .sA .hA =
      -canonicalHshPoly θ / (36 * canonicalSlopeCore θ) := by
  simp [canonicalGovernmentHessianEntry, modelGovernmentHessianEntry,
    qASlope, qBSlope, ownSubsidySlope, ownInfrastructureSlope]
  rw [canonicalT0_closed hθ, canonicalT1_closed hθ,
    canonicalChiG_closed, canonicalRho_closed]
  unfold governmentHessianEntry reducedEmissionsSlope canonicalSlopeCore
  field_simp [(cournotD_pos hθ).ne', (canonicalReducedDetNumerator_pos hθ).ne']
  unfold canonicalHshPoly canonicalReducedDetNumerator cournotD
  ring

lemma canonicalHhh_closed {θ : ℝ} (hθ : θ ∈ Icc (0 : ℝ) 1) :
    canonicalGovernmentHessianEntry θ .hA .hA =
      -canonicalHhhPoly θ / (10 * canonicalSlopeCore θ) := by
  simp [canonicalGovernmentHessianEntry, modelGovernmentHessianEntry,
    qASlope, qBSlope, ownSubsidySlope, ownInfrastructureSlope]
  rw [canonicalT0_closed hθ, canonicalT1_closed hθ,
    canonicalChiG_closed, canonicalRho_closed]
  unfold governmentHessianEntry reducedEmissionsSlope canonicalSlopeCore
  field_simp [(cournotD_pos hθ).ne', (canonicalReducedDetNumerator_pos hθ).ne']
  unfold canonicalHhhPoly canonicalReducedDetNumerator cournotD
  ring

lemma canonicalHsCross_closed {θ : ℝ} (hθ : θ ∈ Icc (0 : ℝ) 1) :
    canonicalGovernmentHessianEntry θ .sA .sB =
      -5 * θ * cournotD θ * canonicalHsCrossPoly θ /
        (72 * canonicalSlopeCore θ) := by
  simp [canonicalGovernmentHessianEntry, modelGovernmentHessianEntry,
    qASlope, qBSlope, ownSubsidySlope, ownInfrastructureSlope]
  rw [canonicalT0_closed hθ, canonicalT1_closed hθ,
    canonicalChiG_closed, canonicalRho_closed]
