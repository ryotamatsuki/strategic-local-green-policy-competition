/-- Exact canonical factorization of the response numerator. -/
theorem canonicalCrossInstrumentNumerator_factorization
    {θ : ℝ} (hθ : θ ∈ Icc (0 : ℝ) 1) :
    864 * canonicalSlopeCore θ * canonicalCrossInstrumentNumerator θ =
      -25 * θ * cournotD θ * witnessP (θ ^ 2) := by
  have hcore : canonicalSlopeCore θ ≠ 0 := (canonicalSlopeCore_pos hθ).ne'
  unfold canonicalCrossInstrumentNumerator crossInstrumentNumerator
  rw [canonicalHsh_closed hθ, canonicalHss_closed hθ,
      canonicalHsCross_closed hθ, canonicalHhCross_closed hθ]
  unfold canonicalHssPoly canonicalHshPoly canonicalHsCrossPoly
    canonicalHhCrossPoly witnessP
  field_simp [hcore]
  unfold canonicalSlopeCore canonicalReducedDetNumerator cournotD
  ring

/-- Exact canonical factorization of the own-policy Hessian determinant. -/
theorem canonicalOwnPolicyDet_factorization
    {θ : ℝ} (hθ : θ ∈ Icc (0 : ℝ) 1) :
    6480 * canonicalSlopeCore θ * canonicalOwnPolicyDet θ =
      witnessDetQ (θ ^ 2) := by
  have hcore : canonicalSlopeCore θ ≠ 0 := (canonicalSlopeCore_pos hθ).ne'
  unfold canonicalOwnPolicyDet ownPolicyDet
  rw [canonicalHss_closed hθ, canonicalHsh_closed hθ, canonicalHhh_closed hθ]
  unfold canonicalHssPoly canonicalHshPoly canonicalHhhPoly witnessDetQ
  field_simp [hcore]
  unfold canonicalSlopeCore canonicalReducedDetNumerator cournotD
  ring

lemma canonicalCrossInstrumentNumerator_closed
    {θ : ℝ} (hθ : θ ∈ Icc (0 : ℝ) 1) :
    canonicalCrossInstrumentNumerator θ =
      (-25 * θ * cournotD θ * witnessP (θ ^ 2)) /
        (864 * canonicalSlopeCore θ) := by
  have hden : 864 * canonicalSlopeCore θ ≠ 0 :=
    mul_ne_zero (by norm_num) (canonicalSlopeCore_pos hθ).ne'
  apply (eq_div_iff hden).2
  calc
    canonicalCrossInstrumentNumerator θ * (864 * canonicalSlopeCore θ) =
        864 * canonicalSlopeCore θ * canonicalCrossInstrumentNumerator θ := by ring
    _ = -25 * θ * cournotD θ * witnessP (θ ^ 2) :=
      canonicalCrossInstrumentNumerator_factorization hθ

lemma canonicalOwnPolicyDet_closed
    {θ : ℝ} (hθ : θ ∈ Icc (0 : ℝ) 1) :
    canonicalOwnPolicyDet θ =
      witnessDetQ (θ ^ 2) / (6480 * canonicalSlopeCore θ) := by
  have hden : 6480 * canonicalSlopeCore θ ≠ 0 :=
    mul_ne_zero (by norm_num) (canonicalSlopeCore_pos hθ).ne'
  apply (eq_div_iff hden).2
  calc
    canonicalOwnPolicyDet θ * (6480 * canonicalSlopeCore θ) =
        6480 * canonicalSlopeCore θ * canonicalOwnPolicyDet θ := by ring
    _ = witnessDetQ (θ ^ 2) := canonicalOwnPolicyDet_factorization hθ

/-- Positive factor multiplying the canonical switching polynomial in the
2x2 differentiated-FOC response algebra. -/
def canonicalOmega (θ : ℝ) : ℝ :=
  375 * θ * cournotD θ / (2 * witnessDetQ (θ ^ 2))

theorem canonicalOmega_pos {θ : ℝ} (hθ : θ ∈ Ioc (0 : ℝ) 1) :
    0 < canonicalOmega θ := by
  have hθIcc : θ ∈ Icc (0 : ℝ) 1 := ⟨hθ.1.le, hθ.2⟩
  have hD : 0 < cournotD θ := cournotD_pos hθIcc
  have hsq : θ ^ 2 ∈ Icc (0 : ℝ) 1 := by
    constructor
    · exact sq_nonneg θ
    · have hp : 0 ≤ (1 - θ) * (1 + θ) :=
        mul_nonneg (sub_nonneg.mpr hθ.2) (by linarith [hθ.1])
      nlinarith
  have hQ : 0 < witnessDetQ (θ ^ 2) := witnessDetQ_pos hsq
  unfold canonicalOmega
  exact div_pos (mul_pos (mul_pos (by norm_num) hθ.1) hD)
    (mul_pos (by norm_num) hQ)

/-- Canonical infrastructure response expressed directly as the quotient supplied
by the Phase-6 2x2 differentiated-FOC algebra. -/
def canonicalInfrastructureResponse (θ : ℝ) : ℝ :=
  canonicalCrossInstrumentNumerator θ / canonicalOwnPolicyDet θ

/-- Phase 7 closes the model-to-quartic bridge: the canonical response generated by
the Phase-6 Hessian is exactly `-Ω(θ) P(θ²)`. -/
theorem canonicalInfrastructureResponse_eq_thresholdResponse
    {θ : ℝ} (hθ : θ ∈ Ioc (0 : ℝ) 1) :
    canonicalInfrastructureResponse θ =
      -canonicalOmega θ * witnessP (θ ^ 2) := by
  have hθIcc : θ ∈ Icc (0 : ℝ) 1 := ⟨hθ.1.le, hθ.2⟩
  have hcore : canonicalSlopeCore θ ≠ 0 := (canonicalSlopeCore_pos hθIcc).ne'
  have hsq : θ ^ 2 ∈ Icc (0 : ℝ) 1 := by
    constructor
    · exact sq_nonneg θ
    · have hp : 0 ≤ (1 - θ) * (1 + θ) :=
        mul_nonneg (sub_nonneg.mpr hθ.2) (by linarith [hθ.1])
      nlinarith
  have hQ : witnessDetQ (θ ^ 2) ≠ 0 := (witnessDetQ_pos hsq).ne'
  unfold canonicalInfrastructureResponse
  rw [canonicalCrossInstrumentNumerator_closed hθIcc,
      canonicalOwnPolicyDet_closed hθIcc]
  unfold canonicalOmega
  field_simp [hcore, hQ]
  ring

lemma witnessP_eq_thresholdQuartic (u : ℝ) :
    witnessP u =
      thresholdQuartic 602500 (-8101550) 39588109 (-74143042) 31863144 u := by
  unfold witnessP thresholdQuartic
  ring

/-- The generic Phase-2 response object specializes exactly to the Phase-7 canonical
response on the economically relevant positive-rivalry range. -/
theorem canonicalInfrastructureResponse_eq_generic_thresholdResponse
    {θ : ℝ} (hθ : θ ∈ Ioc (0 : ℝ) 1) :
    canonicalInfrastructureResponse θ =
      thresholdResponse canonicalOmega 602500 (-8101550) 39588109
        (-74143042) 31863144 θ := by
  rw [canonicalInfrastructureResponse_eq_thresholdResponse hθ]
  unfold thresholdResponse
  rw [← witnessP_eq_thresholdQuartic]

/-- End-to-end canonical sign-switch certificate obtained by feeding the Phase-7
Hessian factorization into the generic Phase-2 theorem. -/
theorem canonicalInfrastructureResponse_unique_switch :
    ∃ θStar ∈ Ioo (0 : ℝ) 1,
      witnessP (θStar ^ 2) = 0 ∧
      (∀ θ ∈ Ioo (0 : ℝ) θStar, canonicalInfrastructureResponse θ < 0) ∧
      (∀ θ ∈ Ioc θStar (1 : ℝ), 0 < canonicalInfrastructureResponse θ) := by
  have hgeneric := thresholdResponse_unique_switch
    canonicalOmega
    (A4 := (602500 : ℝ)) (A3 := (-8101550 : ℝ))
    (A2 := (39588109 : ℝ)) (A1 := (-74143042 : ℝ))
    (A0 := (31863144 : ℝ))
    (by norm_num [thresholdQuartic])
    (by norm_num [thresholdQuartic])
    (by norm_num [thresholdB0])
    (by norm_num [thresholdB1])
    (by norm_num [thresholdB2])
    (by norm_num [thresholdB3])
    (by intro θ hθ; exact canonicalOmega_pos hθ)
  rcases hgeneric with ⟨θStar, hθStar, hroot, hbelow, habove⟩
  refine ⟨θStar, hθStar, ?_, ?_, ?_⟩
  · rw [witnessP_eq_thresholdQuartic]
    exact hroot
  · intro θ hθ
    rw [canonicalInfrastructureResponse_eq_generic_thresholdResponse
      ⟨hθ.1, le_trans hθ.2.le hθStar.2.le⟩]
    exact hbelow θ hθ
  · intro θ hθ
    rw [canonicalInfrastructureResponse_eq_generic_thresholdResponse
      ⟨lt_trans hθStar.1 hθ.1, hθ.2⟩]
    exact habove θ hθ

end SLGPC
